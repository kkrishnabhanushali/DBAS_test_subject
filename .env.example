NODE_ENV=development
PORT=3000
COOKIE_SECURE=false
SESSION_SECRET=your-super-secret-session-key-at-least-64-chars-long-change-this
CSRF_SECRET=your-super-secret-csrf-key-at-least-64-chars-long-change-this

# Database Configuration
# - Leave empty to use the built-in local database (data.db.json)
# - Fill with your Supabase credentials to use Supabase PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WAF (Web Application Firewall)
# Set to 'false' to disable, or 'block' / 'monitor'
WAF_ENABLED=true
WAF_MODE=block

# Vulnerability Scanner Test Bench (Benchmark mode)
# Set to 'true' to expose /api/test-bench for scanner testing
ENABLE_TEST_BENCH=false

# Security Feature Toggles (for scanner testing)
# Set to 'true' to re-enable Helmet & CSP (currently false for scanner testing)
ENABLE_HELMET=false
